{
  "name": "starter-wizytowka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter stron wizytówek: Astro 7 (SSG) + Sanity + Tailwind 4, hosting Cloudflare Pages",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "check": "pnpm --filter web check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "pnpm --filter studio run schema:extract && pnpm --filter studio exec sanity typegen generate",
    "lh": "node --no-warnings scripts/lighthouse.ts",
    "nowy-klient": "node --no-warnings scripts/nowy-klient.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
