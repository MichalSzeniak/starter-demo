{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev --port 3333",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "schema:extract": "sanity schemas extract --enforce-required-fields --force",
    "check": "tsc --noEmit",
    "seed": "node --no-warnings --env-file-if-exists=.env scripts/seed.ts",
    "seed:clean": "node --no-warnings --env-file-if-exists=.env scripts/seed.ts --clean",
    "images:optimize": "node --no-warnings scripts/optimize-images.ts",
    "images:generate": "pnpm --filter web run demo:images"
  },
  "dependencies": {
    "@sanity/icons": "5.2.2",
    "@sanity/vision": "6.13.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.13.2",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@sanity/client": "8.6.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
