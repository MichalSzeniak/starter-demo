# Skopiuj do studio/.env. Plik .env NIE trafia do repozytorium.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Tylko do `pnpm seed` (treści demo) — token z uprawnieniem Editor z sanity.io/manage → API → Tokens.
# Nie jest potrzebny do pracy w Studio ani do builda strony.
SANITY_WRITE_TOKEN=
