# Skopiuj do web/.env i uzupełnij. Plik .env NIE trafia do repozytorium.
#
# Bez SANITY_PROJECT_ID:
#   - `astro dev`   → strona używa treści demo z web/src/lib/sanity/fixtures.ts
#   - `astro build` → build PRZERYWA SIĘ, żeby demo nie trafiło przypadkiem
#                     na produkcję klienta. Chcesz zbudować demo? Ustaw DEMO_CONTENT=true.
SANITY_PROJECT_ID=
SANITY_DATASET=production
DEMO_CONTENT=false
