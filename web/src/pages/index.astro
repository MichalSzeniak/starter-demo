---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { brand } from '~/config/brand';

// FAZA 3: ta strona zostanie zastąpiona przez `[...slug].astro`
// renderujące sekcje z Sanity przez SectionRenderer.
---

<BaseLayout title={`${brand.company.name} — ${brand.company.tagline}`}>
	<section class="content-container py-section">
		<h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">{brand.company.name}</h1>
		<p class="mt-4 max-w-2xl text-lg text-muted">{brand.company.tagline}</p>
		<p class="mt-8 text-sm text-muted">
			Szkielet startera działa. Treść pojawi się tu w fazie 3, gdy strony będą składane z sekcji
			zdefiniowanych w Sanity.
		</p>
	</section>
</BaseLayout>
