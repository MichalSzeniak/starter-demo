---
import Heading from '~/components/Heading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
	title="Nie znaleziono strony (404)"
	description="Strona pod tym adresem nie istnieje."
	noindex
>
	<section class="content-container py-section-lg">
		<p class="text-sm font-medium text-brand">Błąd 404</p>
		<Heading level={1} variant="section" class="mt-2 text-ink">
			Nie znaleźliśmy tej strony
		</Heading>
		<p class="mt-4 max-w-xl text-muted">
			Adres jest nieprawidłowy albo strona została przeniesiona.
		</p>
		<a
			href="/"
			class="mt-8 inline-block rounded-md bg-brand px-5 py-3 font-medium text-white transition-colors hover:bg-brand-dark"
		>
			Wróć na stronę główną
		</a>
	</section>
</BaseLayout>
