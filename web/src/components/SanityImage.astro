---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { resolveImage, type ImageLike } from '~/lib/sanity/image';

/**
 * Jedyny sposób renderowania obrazów z Sanity.
 *
 * - Zawsze width/height w HTML — zero CLS.
 * - Obraz z CDN Sanity przechodzi przez astro:assets: pobierany przy buildzie,
 *   optymalizowany, serwowany lokalnie. W wyjściowym HTML nie ma cdn.sanity.io.
 * - `priority` = pierwszy obraz na stronie: eager + fetchpriority=high + decoding=sync.
 * - `eager` = ładuj od razu, ale bez podbijania priorytetu (logo w nagłówku).
 *   Wszystko inne jest lazy.
 * - Warianty srcset podajemy jawnie (domyślnie połowa i całość), a nie przez
 *   globalny `layout`, który mnożyłby operacje sharpa na każdym obrazie.
 * - WEKTORY (klient wgrywa logo jako SVG): `format="svg"` mówi astro:assets,
 *   żeby przepuścił plik bez zmian. Plik i tak ląduje w dist/, więc w HTML
 *   nadal nie ma odwołania do CDN, ale zostaje wektorem. Bez srcset — warianty
 *   byłyby kopiami tego samego pliku.
 * - Treści demo (pliki z web/public/demo) renderują się jako zwykły <img>.
 * - Wariant bez CMS-u (pliki z src/tresci/obrazy): rastry przez <Image> jak z Sanity,
 *   wektory jako <img> z pliku, który Astro i tak kopiuje do dist/_astro.
 */
interface Props {
	image: ImageLike | null | undefined;
	/** Największa szerokość, jakiej potrzebuje ten slot (px). Wektory ignorują. */
	width: number;
	/** Szerokości do srcset. Domyślnie [width/2, width]. */
	widths?: number[];
	/** Atrybut sizes. Domyślnie: pełna szerokość ekranu do `width`, potem stała. */
	sizes?: string;
	priority?: boolean;
	eager?: boolean;
	class?: string;
}

const {
	image,
	width,
	widths,
	sizes,
	priority = false,
	eager = false,
	class: className,
} = Astro.props;
const resolved = resolveImage(image, width);

// Wariant szerszy niż źródło przycinamy do źródła, zamiast go wyrzucać — inaczej
// pionowe zdjęcie (np. 1068 px przy widths [600, 1200]) zostałoby z samym 600w.
const srcsetWidths = [
	...new Set(
		(widths ?? [Math.round(width / 2), width]).map((w) =>
			resolved ? Math.min(w, resolved.width) : w,
		),
	),
];
const sizesAttr = sizes ?? `(min-width: ${width}px) ${width}px, 100vw`;
const loading = priority || eager ? 'eager' : 'lazy';

// Obrazy, które wychodzą bez astro:assets: placeholdery demo i lokalne wektory.
const plainSrc = !resolved
	? null
	: resolved.source === 'demo'
		? resolved.src
		: resolved.source === 'local' && resolved.vector
			? resolved.src.src
			: null;

// <Image> przyjmuje adres (CDN Sanity) albo ImageMetadata (plik lokalny) — osobne warianty
// propsów, więc źródło przekazujemy jako unię obiektów, nie unię wartości.
const optimized: { src: string } | { src: ImageMetadata } | null =
	resolved?.source === 'sanity'
		? { src: resolved.src }
		: resolved?.source === 'local'
			? { src: resolved.src }
			: null;
---

{resolved &&
	(plainSrc ? (
		<img
			src={plainSrc}
			width={resolved.width}
			height={resolved.height}
			alt={resolved.alt}
			loading={loading}
			decoding={priority ? 'sync' : 'async'}
			fetchpriority={priority ? 'high' : undefined}
			class={className}
		/>
	) : !optimized ? null : resolved.vector ? (
		<Image
			{...optimized}
			width={resolved.width}
			height={resolved.height}
			alt={resolved.alt}
			format="svg"
			priority={priority}
			loading={loading}
			class={className}
		/>
	) : (
		<Image
			{...optimized}
			width={resolved.width}
			height={resolved.height}
			alt={resolved.alt}
			widths={srcsetWidths}
			sizes={sizesAttr}
			priority={priority}
			loading={loading}
			class={className}
		/>
	))}
