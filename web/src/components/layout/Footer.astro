---
import type { Navigation, SiteSettings } from '~/lib/content';
import { formatAddress, formatOpeningHours, socialLabel, telHref } from '~/lib/format';
import { anchorAttributes, resolveLink, type ResolvedLink } from '~/lib/links';

interface Props {
	settings: SiteSettings;
	navigation: Navigation;
}

const { settings, navigation } = Astro.props;

const year = new Date().getFullYear();
const address = formatAddress(settings.address);
const phone = telHref(settings.phone);
const hours = formatOpeningHours(settings.openingHours);
const social = (settings.social ?? []).filter((s) => s.url);

const footerItems = (navigation.footerMenu ?? [])
	.map((item) => ({ label: item.label, link: resolveLink(item.link) }))
	.filter((item): item is { label: string; link: ResolvedLink } =>
		Boolean(item.label && item.link),
	);
---

<footer class="mt-section border-t border-border bg-surface-alt">
	<div class="content-container grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
		<div class="lg:col-span-2">
			<p class="text-lg font-semibold text-ink">{settings.companyName}</p>
			{settings.tagline && <p class="mt-2 max-w-md text-sm text-muted">{settings.tagline}</p>}
			{settings.nip && <p class="mt-4 text-sm text-muted">NIP: {settings.nip}</p>}
		</div>

		<div>
			<p class="text-sm font-semibold text-ink">Kontakt</p>
			<address class="mt-3 space-y-1 text-sm text-muted not-italic">
				{address && <p>{address}</p>}
				{phone && (
					<p>
						<a class="text-brand hover:text-brand-dark" href={phone}>
							{settings.phone}
						</a>
					</p>
				)}
				{settings.email && (
					<p>
						<a class="text-brand hover:text-brand-dark" href={`mailto:${settings.email}`}>
							{settings.email}
						</a>
					</p>
				)}
			</address>
			{social.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm" role="list">
					{social.map((profile) => (
						<li>
							<a
								href={profile.url}
								rel="me noopener"
								class="text-muted underline-offset-2 hover:text-ink hover:underline"
							>
								{socialLabel(profile.platform)}
							</a>
						</li>
					))}
				</ul>
			)}
		</div>

		<div>
			{hours.length > 0 && (
				<>
					<p class="text-sm font-semibold text-ink">Godziny otwarcia</p>
					<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-muted">
						{hours.map((row) => (
							<>
								<dt>{row.days}</dt>
								<dd>{row.hours}</dd>
							</>
						))}
					</dl>
				</>
			)}
			{footerItems.length > 0 && (
				<nav aria-label="Menu w stopce" class:list={[hours.length > 0 && 'mt-6']}>
					<ul class="space-y-1 text-sm" role="list">
						{footerItems.map((item) => (
							<li>
								<a {...anchorAttributes(item.link)} class="text-muted hover:text-ink">
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)}
		</div>
	</div>

	<div class="content-container border-t border-border py-4 text-xs text-muted">
		&copy; {year} {settings.companyName}
	</div>
</footer>
