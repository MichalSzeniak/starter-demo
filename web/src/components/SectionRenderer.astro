---
import { firstImageSectionIndex, type Section, type SectionContext } from '~/lib/sanity/sections';
import Cta from './sections/Cta.astro';
import Faq from './sections/Faq.astro';
import Features from './sections/Features.astro';
import Gallery from './sections/Gallery.astro';
import Hero from './sections/Hero.astro';
import Pricing from './sections/Pricing.astro';
import Testimonials from './sections/Testimonials.astro';
import TextImage from './sections/TextImage.astro';

/**
 * Mapuje `_type` sekcji na komponent. `switch` zamiast słownika, bo TypeScript
 * zawęża wtedy typ sekcji w każdej gałęzi — komponent dostaje dokładnie swoje pola.
 *
 * Dokłada kontekst: pierwsza sekcja dostaje h1, kolejne h2; sekcja z pierwszym
 * obrazem na stronie dostaje `priorityImage` (eager + fetchpriority=high).
 */
interface Props {
	sections: Section[] | null | undefined;
}

const { sections } = Astro.props;
const list = sections ?? [];
const firstImage = firstImageSectionIndex(list);

function contextFor(index: number): SectionContext {
	return {
		index,
		headingLevel: index === 0 ? 1 : 2,
		priorityImage: index === firstImage,
	};
}
---

{list.map((section, index) => {
	const ctx = contextFor(index);
	switch (section._type) {
		case 'hero':
			return <Hero section={section} ctx={ctx} />;
		case 'textImage':
			return <TextImage section={section} ctx={ctx} />;
		case 'features':
			return <Features section={section} ctx={ctx} />;
		case 'pricing':
			return <Pricing section={section} ctx={ctx} />;
		case 'testimonials':
			return <Testimonials section={section} ctx={ctx} />;
		case 'faq':
			return <Faq section={section} ctx={ctx} />;
		case 'gallery':
			return <Gallery section={section} ctx={ctx} />;
		case 'cta':
			return <Cta section={section} ctx={ctx} />;
		default: {
			// Schema jest zamknięta — tu nie da się trafić bez zmiany schemy.
			const unknown: never = section;
			console.warn('[SectionRenderer] Nieznany typ sekcji:', unknown);
			return null;
		}
	}
})}
