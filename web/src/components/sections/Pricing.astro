---
import Heading from '~/components/Heading.astro';
import LinkButton from '~/components/LinkButton.astro';
import { toneClass, type SectionContext, type SectionOf } from '~/lib/sanity/sections';

interface Props {
	section: SectionOf<'pricing'>;
	ctx: SectionContext;
}

const { section, ctx } = Astro.props;
const plans = section.plans ?? [];
const planLevel = ctx.headingLevel === 1 ? 2 : 3;
---

<section class={toneClass(ctx.tone)}>
	<div class="content-container py-section">
		{section.heading && (
			<Heading level={ctx.headingLevel} variant="section" class="text-ink">
				{section.heading}
			</Heading>
		)}
		{section.lead && <p class="mt-4 max-w-2xl text-lg text-muted">{section.lead}</p>}
		<ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
			{plans.map((plan) => (
				<li
					class:list={[
						'flex flex-col rounded-lg border bg-surface p-6',
						plan.recommended ? 'border-brand ring-2 ring-brand' : 'border-border',
					]}
				>
					{plan.recommended && (
						<p class="mb-3 text-xs font-semibold tracking-wide text-brand uppercase">Polecane</p>
					)}
					<Heading level={planLevel} class="text-lg font-semibold text-ink">
						{plan.name}
					</Heading>
					<p class="mt-3 flex items-baseline gap-1">
						<span class="text-3xl font-bold text-ink">{plan.price}</span>
						{plan.unit && <span class="text-sm text-muted">{plan.unit}</span>}
					</p>
					{plan.description && <p class="mt-3 text-muted">{plan.description}</p>}
					{plan.includes && plan.includes.length > 0 && (
						<ul class="mt-5 space-y-2 text-sm text-muted" role="list">
							{plan.includes.map((line) => (
								<li class="flex gap-2">
									<span aria-hidden="true" class="text-brand">
										✓
									</span>
									<span>{line}</span>
								</li>
							))}
						</ul>
					)}
					{plan.button && (
						<div class="mt-6 pt-2">
							<LinkButton
								item={plan.button}
								variant={plan.recommended ? 'primary' : 'secondary'}
								class="w-full"
							/>
						</div>
					)}
				</li>
			))}
		</ul>
	</div>
</section>
