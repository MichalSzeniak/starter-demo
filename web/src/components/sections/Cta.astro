---
import Heading from '~/components/Heading.astro';
import LinkButton from '~/components/LinkButton.astro';
import type { SectionContext, SectionOf } from '~/lib/sanity/sections';

interface Props {
	section: SectionOf<'cta'>;
	ctx: SectionContext;
}

const { section, ctx } = Astro.props;
// Jedyna sekcja, która może stać na kolorze marki — kolory tekstu i przycisku
// zależą od tła. Na jasnym tle wygląda jak pozostałe sekcje, z przyciskiem głównym.
const accent = ctx.background === 'accent';
---

<section class={ctx.backgroundClass}>
	<div class="content-container flex flex-col items-start gap-6 py-section md:flex-row md:items-center md:justify-between">
		<div>
			<Heading level={ctx.headingLevel} variant="section" class={accent ? undefined : 'text-ink'}>
				{section.heading}
			</Heading>
			{section.lead && (
				<p class:list={['mt-3 max-w-2xl text-lg', accent ? 'text-white/85' : 'text-muted']}>
					{section.lead}
				</p>
			)}
		</div>
		<LinkButton item={section.button} variant={accent ? 'inverse' : 'primary'} class="shrink-0" />
	</div>
</section>
