---
import Heading from '~/components/Heading.astro';
import { toneClass, type SectionContext, type SectionOf } from '~/lib/sanity/sections';

interface Props {
	section: SectionOf<'features'>;
	ctx: SectionContext;
}

const { section, ctx } = Astro.props;
const items = section.items ?? [];
const itemLevel = ctx.headingLevel === 1 ? 2 : 3;
---

<section class={toneClass(ctx.tone)}>
	<div class="content-container py-section">
		{section.heading && (
			<Heading level={ctx.headingLevel} variant="section" class="text-ink">
				{section.heading}
			</Heading>
		)}
		{section.lead && <p class="mt-4 max-w-2xl text-lg text-muted">{section.lead}</p>}
		<ul class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
			{items.map((item) => (
				<li class="border-l-2 border-brand py-1 pl-5">
					<Heading level={itemLevel} class="text-lg font-semibold text-ink">
						{item.title}
					</Heading>
					{item.description && <p class="mt-2 text-muted">{item.description}</p>}
				</li>
			))}
		</ul>
	</div>
</section>
