---
import Heading from '~/components/Heading.astro';
import type { SectionContext, SectionOf } from '~/lib/sanity/sections';

interface Props {
	section: SectionOf<'features'>;
	ctx: SectionContext;
}

const { section, ctx } = Astro.props;
const items = section.items ?? [];
const itemLevel = ctx.headingLevel === 1 ? 2 : 3;
---

<section class="bg-surface-alt">
	<div class="content-container py-section">
		{section.heading && (
			<Heading
				level={ctx.headingLevel}
				class="text-3xl font-bold tracking-tight text-ink sm:text-4xl"
			>
				{section.heading}
			</Heading>
		)}
		{section.lead && <p class="mt-4 max-w-2xl text-lg text-muted">{section.lead}</p>}
		<ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
			{items.map((item) => (
				<li class="rounded-lg border border-border bg-surface p-6">
					<Heading level={itemLevel} class="text-lg font-semibold text-ink">
						{item.title}
					</Heading>
					{item.description && <p class="mt-2 text-muted">{item.description}</p>}
				</li>
			))}
		</ul>
	</div>
</section>
