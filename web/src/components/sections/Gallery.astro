---
import Carousel from '~/components/Carousel.astro';
import Heading from '~/components/Heading.astro';
import SanityImage from '~/components/SanityImage.astro';
import type { SectionContext, SectionOf } from '~/lib/sanity/sections';

interface Props {
	section: SectionOf<'gallery'>;
	ctx: SectionContext;
}

const { section, ctx } = Astro.props;
const items = section.items ?? [];
const carousel = section.layout === 'carousel';

// Siatka: trzy kolumny, chyba że zostawiłyby w ostatnim rzędzie jedno zdjęcie,
// a dwie kolumny dzielą liczbę równo (4, 10, 16, 22) — wtedy 2×N. Dwa zdjęcia
// też w dwóch kolumnach, zamiast pustego trzeciego slotu.
const count = items.length;
const twoColumns = !carousel && (count === 2 || (count % 3 === 1 && count % 2 === 0));

// Rozmiary zgodne z szerokością kafelka w danym układzie (Carousel: 85/45/30%).
const imageProps = carousel
	? {
			width: 800,
			widths: [400, 800],
			sizes: '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 85vw',
		}
	: twoColumns
		? { width: 1200, widths: [600, 1200], sizes: '(min-width: 640px) 50vw, 100vw' }
		: {
				width: 800,
				widths: [400, 800],
				sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
			};
const imageClass = 'aspect-[4/3] h-auto w-full rounded-md object-cover';
const itemLevel = ctx.headingLevel === 1 ? 2 : 3;

/*
 * Podpis POD zdjęciem (<figcaption>), nie nakładka. Hover nie istnieje na dotyku,
 * a nakładka na stałe ma kontrast zależny od zdjęcia i zasłania kadr. Pod
 * zdjęciem tekst jest zawsze widoczny, czytelny i taki sam na każdym urządzeniu.
 * `alt` opisuje obraz, podpis nazywa realizację — czytnik ekranu czyta oba.
 * W siatce odstęp między rzędami (gap-y-10) jest dużo większy niż podpis od
 * zdjęcia (mt-3) — inaczej nie widać, do którego zdjęcia podpis należy.
 */
---

<section class={ctx.backgroundClass}>
	<div class="content-container py-section">
		{section.heading && (
			<Heading level={ctx.headingLevel} variant="section" class="text-ink">
				{section.heading}
			</Heading>
		)}
		{carousel ? (
			<Carousel label={section.heading || 'Galeria zdjęć'} class="mt-8">
				{items.map((item, i) => (
					<li>
						<figure>
							<SanityImage
								image={item.image}
								{...imageProps}
								priority={ctx.priorityImage && i === 0}
								class={imageClass}
							/>
							{(item.title || item.description) && (
								<figcaption class="mt-3">
									{item.title && (
										<Heading level={itemLevel} class="font-semibold text-ink">
											{item.title}
										</Heading>
									)}
									{item.description && (
										<p class:list={['text-sm text-muted', item.title && 'mt-1']}>
											{item.description}
										</p>
									)}
								</figcaption>
							)}
						</figure>
					</li>
				))}
			</Carousel>
		) : (
			<ul
				class:list={['mt-8 grid gap-x-4 gap-y-10 sm:grid-cols-2', !twoColumns && 'lg:grid-cols-3']}
				role="list"
			>
				{items.map((item, i) => (
					<li>
						<figure>
							<SanityImage
								image={item.image}
								{...imageProps}
								priority={ctx.priorityImage && i === 0}
								class={imageClass}
							/>
							{(item.title || item.description) && (
								<figcaption class="mt-3">
									{item.title && (
										<Heading level={itemLevel} class="font-semibold text-ink">
											{item.title}
										</Heading>
									)}
									{item.description && (
										<p class:list={['text-sm text-muted', item.title && 'mt-1']}>
											{item.description}
										</p>
									)}
								</figcaption>
							)}
						</figure>
					</li>
				))}
			</ul>
		)}
	</div>
</section>
