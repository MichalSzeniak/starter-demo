---
import Carousel from '~/components/Carousel.astro';
import Heading from '~/components/Heading.astro';
import TestimonialCard from '~/components/TestimonialCard.astro';
import type { SectionContext, SectionOf } from '~/lib/sanity/sections';

interface Props {
	section: SectionOf<'testimonials'>;
	ctx: SectionContext;
}

const { section, ctx } = Astro.props;
const items = section.items ?? [];
---

<section id={ctx.anchor} class={ctx.backgroundClass}>
	<div class="content-container py-section">
		{section.heading && (
			<Heading level={ctx.headingLevel} variant="section" class="text-ink">
				{section.heading}
			</Heading>
		)}
		{section.layout === 'carousel' ? (
			<Carousel label={section.heading || 'Opinie klientów'} class="mt-10">
				{items.map((item) => (
					<li>
						<TestimonialCard item={item} />
					</li>
				))}
			</Carousel>
		) : (
			<ul class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3" role="list">
				{items.map((item) => (
					<li>
						<TestimonialCard item={item} />
					</li>
				))}
			</ul>
		)}
	</div>
</section>
