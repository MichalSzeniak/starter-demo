---
import { Font } from 'astro:assets';
import Footer from '~/components/layout/Footer.astro';
import Header from '~/components/layout/Header.astro';
import Analytics from '~/components/seo/Analytics.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import Seo from '~/components/seo/Seo.astro';
import { brand, themeCss } from '~/config/brand';
import { getNavigation, getSiteSettings } from '~/lib/content';
import { jsonLdGraph, type JsonLdNode } from '~/lib/seo/jsonld';
import { generatedOgImage, ogImageFromSanity, requireSite, type OgImage } from '~/lib/seo/og-image';
import { getSiteGraph } from '~/lib/seo/site-graph';
import '~/styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Ustaw na true tam, gdzie strona nie ma trafić do indeksu (np. 404). */
	noindex?: boolean;
	/** Obraz OG strony. Bez niego: domyślny z ustawień albo wygenerowany dla strony głównej. */
	ogImage?: OgImage | null;
	/** Dodatkowe węzły JSON-LD strony (okruszki, FAQ). Organization i WebSite dokładane zawsze. */
	jsonLd?: (JsonLdNode | null | undefined)[];
}

const site = requireSite(Astro.site);

// Ustawienia i nawigacja są memoizowane w content.ts — jedno pobranie na build.
const [settings, navigation, siteGraph] = await Promise.all([
	getSiteSettings(),
	getNavigation(),
	getSiteGraph(site),
]);

const {
	title,
	description = settings.tagline ?? brand.company.tagline,
	noindex = false,
	jsonLd = [],
} = Astro.props;

const ogImage =
	Astro.props.ogImage ??
	(await ogImageFromSanity(settings.defaultOgImage, site)) ??
	generatedOgImage('strona-glowna', site, settings.companyName);

// Canonical spójny z `trailingSlash: 'never'` — jedyny wyjątek to strona główna,
// gdzie kanoniczną formą jest sam ukośnik.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(canonicalPath, site).href;

// Uwaga na kolejność w <head>:
// 1. `themeCss` — zmienne z brand.ts, muszą poprzedzać arkusz Tailwinda.
// 2. `<Font>` — generuje @font-face i <link rel="preload"> dla obu podzbiorów
//    (latin i latin-ext). Pliki są hostowane lokalnie, pobrane przy buildzie,
//    więc w wyjściowym HTML nie ma ani jednego requestu do Google.
//    Preload obejmuje oba podzbiory, bo polski tekst sięga po latin-ext
//    już w pierwszym nagłówku.
---

<!doctype html>
<html lang={brand.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Seo
			title={title}
			description={description}
			canonical={canonical}
			siteName={settings.companyName}
			locale={brand.locale}
			noindex={noindex}
			ogImage={ogImage}
		/>

		<style is:inline set:html={themeCss}></style>
		<Font cssVariable="--font-brand-sans" preload />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<JsonLd data={jsonLdGraph([...siteGraph, ...jsonLd])} />
		<Analytics analytics={settings.analytics} />
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#tresc"
			class="sr-only rounded-sm bg-brand px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
		>
			Przejdź do treści
		</a>

		<Header settings={settings} navigation={navigation} />

		<main id="tresc" class="flex-1">
			<slot />
		</main>

		<Footer settings={settings} navigation={navigation} />
	</body>
</html>
