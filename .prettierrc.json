{
  "useTabs": true,
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": ["*.json", "*.md", "*.yaml", "*.yml"], "options": { "useTabs": false } }
  ]
}
